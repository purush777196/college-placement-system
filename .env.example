# CampusConnect Frontend Environment Variables (Example)
# In Phase 0, all services operate in mock mode.
# In future phases, these will point to the Django REST API backend.

VITE_APP_NAME="CampusConnect"
VITE_APP_ENV="development"
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_ENABLE_MOCK_SERVICES="true"

